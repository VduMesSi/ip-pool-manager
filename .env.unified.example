# Copy to .env in the unified Compose project directory.
# These paths point to the EXISTING NAS directories; do not move or delete them.
IP_POOL_HOME=/share/CACHEDEV1_DATA/Container/ip-pool-manager
XMAN_HOME=/share/CACHEDEV1_DATA/Container/xray-manager

# Copy the existing secrets from each service's current .env file.
IP_POOL_API_TOKEN=replace_with_existing_ip_pool_api_token
XMAN_API_TOKEN=replace_with_existing_xray_manager_api_token

# Optional; defaults to ipv60.
XMAN_DEFAULT_FAMILY=ipv60
